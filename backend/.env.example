# ── Required ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...

# ── Server ────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────
DB_PATH=./data/chat.db

# ── CORS ──────────────────────────────────────────────────────────────
# Dev:  http://localhost:5173
# Prod: your Vercel URL e.g. https://spur-assignment.vercel.app
CORS_ORIGIN=http://localhost:5173

# ── Redis (optional — Upstash free tier) ──────────────────────────────
# Sign up at https://console.upstash.com → New Database → copy the Redis URL
# Must use rediss:// (TLS) for Upstash
# REDIS_URL=rediss://default:<password>@<host>.upstash.io:6380

# ── LLM ───────────────────────────────────────────────────────────────
LLM_MODEL=gpt-4o-mini

# ── Limits ────────────────────────────────────────────────────────────
MAX_MESSAGE_LENGTH=2000
MAX_HISTORY_MESSAGES=20
MAX_TOKENS=1024

# ── Rate limiting ─────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=60
